{
  "name": "cortex-launch-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "manifest": "node scripts/clips-manifest.mjs",
    "studio": "node scripts/clips-manifest.mjs && remotion studio",
    "render": "node scripts/clips-manifest.mjs && remotion render CortexLaunch out/cortex-launch.mp4",
